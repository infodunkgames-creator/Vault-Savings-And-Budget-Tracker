{
  "name": "vault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vault — personal finance & budgeting app",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.22.3",
    "lucide-react": "^1.70.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
